#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @RE1_WINDOWS_VERSION@,0
 PRODUCTVERSION @RE1_WINDOWS_VERSION@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Resident Evil Recompiled (experimental local build)\0"
            VALUE "FileVersion", "@RE1_RELEASE_VERSION@\0"
            VALUE "InternalName", "Resident_Evil_Recompiled\0"
            VALUE "OriginalFilename", "Resident_Evil_Recompiled.exe\0"
            VALUE "ProductName", "Resident Evil Recompiled\0"
            VALUE "ProductVersion", "@RE1_RELEASE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
